__pycache__/

# Encrypted credential vault - prevents GitHub secret scanner false positives
# Files in vault/ are AES-256 encrypted but trigger scanner due to ciphertext patterns
vault/

# Agent configuration files containing API keys and passwords
ava_email_config.json
himalaya-zak.toml
config/himalaya-*.toml
config/*-agentmail.toml
memory/secrets_vault.json
.secure/

# Log files - prevent large files from being tracked
log-aggregator/logs.db
*.db
*.log.archive
memory/*.log
logs/*.log
*.log

# Large data files
*.sqlite
*.sqlite3
*.db-journal

# Image files - prevent accidental credential screenshots from being tracked
*.png
*.jpg
*.jpeg
*.gif
