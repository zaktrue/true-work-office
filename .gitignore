# Ignore everything by default
*

# Except website essentials
!.gitignore
!hugo.toml
!hugo.yaml
!config.toml
!config.yaml
!README.md

# Content
!content/
!content/**

# Static assets
!static/
!static/**

# Themes
!themes/
!themes/**

# Layouts
!layouts/
!layouts/**

# Assets
!assets/
!assets/**

# Data
# NOTE (2026-07-06 privacy audit): data/ used to be whitelisted wholesale,
# which tracked internal operational databases/logs (agent activity dbs,
# scrape caches, healthcheck.json with server infra details, etc.) into
# this PUBLIC repo. Hugo does not use .Site.Data here (no template
# references .Data./.Site.Data), so nothing in data/ is needed for the
# site build. Deliberately not whitelisted - see memory/2026-07-06-public-repo-audit.md.
# i18n
!i18n/
!i18n/**

# GitHub Actions
!.github/
!.github/**

# Archetypes
!archetypes/
!archetypes/**

# But ignore specific sensitive files even in allowed directories
**/*.env
**/.env
**/secrets*
**/credentials*
**/*private*

# Exception: Track dashboard generator
!database/generate_dashboard.py

# Track dashboard generator (need to unignore directory first)
!database/
!database/generate_dashboard.py

# Track health dashboard generator (same pattern as generate_dashboard.py above -
# need to unignore the scripts/ directory first, then the specific file)
!scripts/
!scripts/generate_health_dashboard.py
