.cache/
.clawdhub/
.clawhub/
.config/
.openclaw/

# Environment and secrets
.env*
.secure/
.moltbook_credentials.json

# Agent configs with credentials
ava_email_config.json
himalaya-zak.toml
config/
!config/crontab.mission-control

# Memory and logs (large, local only)
memory/
logs/
*.log
*.log.archive

# Databases (large binary files)
*.db
*.db-journal
*.sqlite
*.sqlite3
database/*.db

# Documentation and project files (not website)
*.md
!true-work-office/**/*.md

# Agent files
AGENTS.md
